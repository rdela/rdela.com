<figure class="post-hero">
  <a
    href="{{ image }}"
  >
    <img
      src="{{ image.substring(0, image.lastIndexOf(".")) }}-hero{{ image.substring(image.lastIndexOf(".")) }}"
      alt="{{ alt }}"
      loading="lazy"
      {{ if backdrop }}class="backdrop"{{ /if }}
    />
  </a>
  {{ if caption }}
    <figcaption>
      {{ caption }}
    </figcaption>
  {{ /if }}
</figure>
