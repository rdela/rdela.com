<figure class="post-placard">
  <a
    href="{{ image }}"
  >
    {{ if intrinsic }}
      {{ set placard_ratio = intrinsic }}
    {{ else }}
      {{ set placard_ratio = "scope" }}
    {{ /if }}
    {{# 
      included intrinsic ratios: 
      sixteen-nine - 1.78:1 = 16:9, 
      flat - 1.85:1 = 37:20, 
      scope - 2.39:1 = 43:18, 
      ultra - 2.76:1 = 69:25
      see class declaration blocks in style.css + 
      https://en.wikipedia.org/wiki/Aspect_ratio_(image)#Previous_and_currently_used_aspect_ratios
    #}}  
    <div class="{{ placard_ratio }} intrinsic" style="background-image: url({{ image.substring(0, image.lastIndexOf(".")) }}-hero{{ image.substring(image.lastIndexOf(".")) }});">
      <div class="{{ placard_ratio }} intrinsic scrim">
        {{ await comp.title({ text: title }) }}
        {{ if subtitle }}
          <div class="post-subtitle">{{ subtitle |> md }}</div>
        {{ /if }}
      </div>
    </div>
  </a>
  {{ if caption }}
    <figcaption>
      {{ caption }}
    </figcaption>
  {{ /if }}
</figure>
