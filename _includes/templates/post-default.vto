<header class="post-header">
  {{ if page }}
    <h1 class="post-title">{{ it.title }}</h1>
    {{ it.subtitle |> md }}
  {{ else }}
    <h1 class="post-title">{{ title }}</h1>
    {{ include "templates/post-details.vto" }}
  {{ /if }}
</header>

<div class="post-body body">
  <section class="post-main" {{ mainContainerAttr }}>
    {{ if toc.length }}
      <nav class="toc">
        <h2>{{ i18n.nav.toc }}</h2>
        <ol>
          {{ for item of toc }}
            <li>
              <a href="#{{ item.slug }}">{{ item.text }}</a>

              {{ if item.children.length }}
                <ul>
                  {{ for child of item.children }}
                    <li>
                      <a href="#{{ child.slug }}">{{ child.text }}</a>
                    </li>
                  {{ /for }}
                </ul>
              {{ /if }}
            </li>
          {{ /for }}
        </ol>
      </nav>
    {{ /if }}
    {{# /toc.length #}}

    {{ content }}
  </section>

  <section class="post-extras" {{ imgContainerAttr }}>
    {{ if videos }}
      <link rel="stylesheet" href="/lyt/lite-yt-embed.css">
      {{ for vid of videos }}
        {{
          await comp.lyt({
            id: vid.id,
            title: vid.title,
            caption: vid.caption,
          })
        }}
      {{ /for }}
      <script defer src="/lyt/lite-yt-embed.js"></script>
    {{ /if }}
    {{# /videos #}}

    {{ if images }}
      {{ for img of images }}
        {{
          await comp.hero({
            image: img.src,
            alt: img.alt,
            caption: img.caption,
            backdrop: img.backdrop,
          })
        }}
      {{ /for }}
    {{ /if }}
    {{# /images #}}
  </section>
</div>

{{ if it.footnotes.length }}
  <aside role="note" class="footnotes">
    <dl>
      {{ for note of footnotes }}
        <div id="{{ note.id }}" class="footnote">
          <dt><a href="#{{ note.refId }}">{{ note.label }}</a></dt>
          <dd>{{ note.content }}</dd>
        </div>
      {{ /for }}
    </dl>
  </aside>
{{ /if }}
