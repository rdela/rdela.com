<ul class="postList">
  {{ for post of postslist }}
    <li class="post">
      {{ if post.image }}
        <div class="post-thumb">
          <a href="{{ post.url }}">
            <img
              src="{{ post.image.substring(0, post.image.lastIndexOf('.')) }}-thumb{{
    post.image.substring(post.image.lastIndexOf('.'))
  }}"
              {{# see img/_data.yml #}}
              alt="{{ post.alt }}"
              loading="lazy"
            />
          </a>
        </div>
      {{ /if }}

      <div class="post-card">
        <h2 class="post-title">
          <a
            href="{{ post.url }}"
            {{ if post.url == url }}
              aria-current="page"{{ /if }}
          >{{ post.title }}</a>
        </h2>

        {{
          include "templates/post-details.vto" {
            author: post.author,
            date: post.date,
            image: post.image,
            readingInfo: post.readingInfo,
            tags: post.tags,
          }
        }}

        <div class="post-excerpt body">
          {{ post.excerpt |> md }}
        </div>
      </div>
      {{# /post-card #}}
    </li>
  {{ /for }}
</ul>
